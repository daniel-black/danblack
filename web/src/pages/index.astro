---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sections } from '../sections.ts';
import { PERSON, SITE_NAME } from '../seo.ts';

const bands = ['--sky-1', ...sections.map((s) => s.band)];
// Relative band heights: tallest up high, thinning toward the horizon (hero is 30).
const weights = [20, 16, 13, 11];

// The site and the person it's about, for search engines.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': 'https://danblack.co/#website', name: SITE_NAME, url: 'https://danblack.co/', author: { '@id': PERSON['@id'] } },
    PERSON,
  ],
};
---

<BaseLayout
  title="Dan Black — Software Engineer"
  description="Dan Black is a software engineer in Denver building software for U.S. space superiority."
  jsonLd={jsonLd}
>
  <main class="home">
    <div class="hero" style="--c: var(--sky-1)">
      <div>
        <h1 class="site-title" transition:name="site-title">Dan Black</h1>
        <p class="site-title site-tagline">Software Engineer</p>
      </div>
    </div>
    <nav class="contents" aria-label="Sections">
      {
        sections.map((s, i) => (
          <>
            <div class="dither" style={`--a: var(${bands[i]}); --b: var(${s.band})`} />
            <a class="band-link" href={`/${s.slug}/`} style={`flex-grow: ${weights[i]}`}>
              <span class="band-fill" style={`--c: var(${s.band})`} transition:name={`band-${s.slug}`} />
              <span class="band-label">
                <span class="cursor" aria-hidden="true">▶</span>
                {s.title}
              </span>
            </a>
          </>
        ))
      }
    </nav>
  </main>
</BaseLayout>
