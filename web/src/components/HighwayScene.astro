---
// Open-road backdrop for the Freightquote page. The sky stays (clouds, birds, weather);
// the grass footer is swapped for a prairie highway that rises into view on arrival, and a
// semi rolls across the near lane now and then, like the boats on the home page's sea.
---

<div class="highway" aria-hidden="true">
  <div class="land">
    <div class="terrain">
      <div class="hills"></div>
      <div class="prairie"></div>
      <div class="road"></div>
      <div class="verge"></div>
      <div class="poles"></div>
    </div>
    <div class="semi">
      <img src="/sprites/semi.svg" alt="" width="60" height="21" />
      <div class="beam"></div>
    </div>
  </div>
</div>

<style is:global>
  /* The highway replaces the sea-and-grass footer (and the grass critter with it). */
  :root:has(.highway) footer.ground {
    display: none;
  }

  :root:has(.highway) .stage {
    padding-bottom: calc(64 * var(--hpx, 4px) + 2rem);
  }
</style>

<style>
  .highway {
    --hpx: 4px; /* one art pixel */
    position: fixed;
    inset: auto 0 0;
    z-index: 0;
    pointer-events: none;
  }

  @media (max-width: 40rem) {
    .highway {
      --hpx: 3px;
    }
  }

  /* 64 art pixels tall: hills 18, prairie 10, road 22, verge 14 (top to bottom). */
  .land {
    position: relative;
    height: calc(64 * var(--hpx));
    animation: rise 1.1s 0.15s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .terrain {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: 18fr 10fr 22fr 14fr;
    filter: var(--ground-time) var(--ground-weather);
  }

  .hills {
    background: url('/sprites/hills.svg') 0 100% / calc(128 * var(--hpx)) 100% repeat-x;
  }

  .prairie {
    background:
      url('/sprites/prairie.svg') 0 0 / calc(32 * var(--hpx)) calc(6 * var(--hpx)) repeat-x,
      #b4c864;
  }

  /* Gravel shoulders, white edge lines, and a dashed yellow center line. */
  .road {
    --u: var(--hpx);
    background:
      repeating-linear-gradient(90deg, #f0d060 0 calc(8 * var(--u)), transparent 0 calc(16 * var(--u))) 0
        calc(10 * var(--u)) / 100% calc(2 * var(--u)) no-repeat,
      linear-gradient(#e8e8e0, #e8e8e0) 0 calc(2 * var(--u)) / 100% var(--u) no-repeat,
      linear-gradient(#e8e8e0, #e8e8e0) 0 calc(19 * var(--u)) / 100% var(--u) no-repeat,
      linear-gradient(#a89e8a 0 calc(2 * var(--u)), #565a62 0 calc(20 * var(--u)), #a89e8a 0);
  }

  .verge {
    background:
      url('/sprites/grass.svg') 0 calc(-3 * var(--hpx)) / calc(32 * var(--hpx)) calc(13 * var(--hpx)) repeat-x,
      #4a8a46;
  }

  /* A line of telephone poles behind the road, joined by a wire at crossbar height. */
  .poles {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(37 * var(--hpx));
    height: calc(30 * var(--hpx));
    background:
      url('/sprites/pole.svg') 0 0 / calc(48 * var(--hpx)) 100% repeat-x,
      linear-gradient(#3a3440, #3a3440) 0 calc(3 * var(--hpx)) / 100% 1px no-repeat;
  }

  /* The semi crosses in about 35s, then the road is empty for a while. */
  /* Tires sit in the near lane, between the edge line and the center line. */
  .semi {
    position: absolute;
    left: 0;
    bottom: calc(19 * var(--hpx));
    width: calc(60 * var(--hpx));
    height: calc(21 * var(--hpx));
    animation:
      drive 50s linear -12s infinite,
      rumble 0.5s steps(1) infinite;
  }

  .semi img {
    display: block;
    width: 100%;
    height: 100%;
  }

  @keyframes drive {
    from {
      translate: -100% 0;
    }
    70%,
    to {
      translate: 100vw 0;
    }
  }

  @keyframes rumble {
    50% {
      transform: translateY(calc(var(--hpx) * -0.5));
    }
  }

  /* Headlights, only when it's dark or stormy. */
  .beam {
    position: absolute;
    left: 100%;
    top: calc(8 * var(--hpx));
    display: none;
    width: calc(28 * var(--hpx));
    height: calc(8 * var(--hpx));
    background: linear-gradient(to right, oklch(95% 0.1 95 / 0.55), transparent);
    clip-path: polygon(0 40%, 100% 0, 100% 100%, 0 60%);
  }

  :global(:root[data-time='night']) .beam,
  :global(:root[data-time='dusk']) .beam,
  :global(:root[data-weather='storm']) .beam {
    display: block;
  }

  :global(:root[data-time='night']) .semi img {
    filter: brightness(0.7);
  }

  @keyframes rise {
    from {
      translate: 0 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .land,
    .semi {
      animation: none;
    }

    .semi {
      translate: 18vw 0;
    }
  }
</style>
