---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Analytics from '../components/Analytics.astro';
import Boats from '../components/Boats.astro';
import Descent from '../components/Descent.astro';
import PageTransitions from '../components/PageTransitions.astro';
import Sky from '../components/Sky.astro';
import SkyControls from '../components/SkyControls.astro';
import SkyState from '../components/SkyState.astro';
import { PROFILES, SITE_NAME } from '../seo.ts';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Social preview image: a 1200×630 path under public/. Defaults to the site-wide image. */
  image?: { src: string; alt: string };
  /** Marks the page as an article (og:type and published/modified times). */
  article?: { publishedTime: Date; modifiedTime?: Date | undefined };
  /** schema.org structured data for this page. */
  jsonLd?: Record<string, unknown>;
  /** Keep the page out of search results (e.g. the 404 page). */
  noindex?: boolean;
}

const DEFAULT_IMAGE = {
  src: '/og.png',
  alt: 'Dan Black in pixel letters over a sky with clouds, above a sailboat on the sea and a strip of grass.',
};

const { title, description, image = DEFAULT_IMAGE, article, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-geist-pixel" preload />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE_NAME} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#4aa8e8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Dan Black — Writing" href="/writing/rss.xml" />
    {PROFILES.map((href) => <link rel="me" href={href} />)}

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.publishedTime.toISOString()} />}
    {
      article?.modifiedTime && (
        <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
      )
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={image.alt} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <SkyState />
    <PageTransitions />
    <Analytics />
  </head>
  <body>
    <Sky />
    <Descent />
    <slot />
    <footer class="ground" transition:persist="ground">
      <Boats />
      <SkyControls />
    </footer>
  </body>
</html>
