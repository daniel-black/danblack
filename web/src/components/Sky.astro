---
// Clouds and birds drift above the bands on every page and persist across navigation.

// Resting x (vw) is used when motion is reduced; duration/delay drive the drift.
const clouds = [
  { src: '/sprites/cloud-lg.svg', w: 32, h: 13, top: '8%', x: 10, duration: 160, delay: -40 },
  { src: '/sprites/cloud-sm.svg', w: 16, h: 7, top: '4%', x: 55, duration: 220, delay: -150 },
  { src: '/sprites/cloud-lg.svg', w: 32, h: 13, top: '20%', x: 70, duration: 120, delay: -95 },
  { src: '/sprites/cloud-sm.svg', w: 16, h: 7, top: '34%', x: 30, duration: 90, delay: -20 },
];

// Each bird crosses in the first quarter of its loop, then stays offscreen for the rest.
const birds = [
  { top: '14%', scale: 0.75, loop: 48, delay: -6 },
  { top: '22%', scale: 0.5, loop: 75, delay: -40 },
  { top: '9%', scale: 0.625, loop: 110, delay: -80 },
];

// Night only: bats flutter and swoop; `reverse` flies left to right.
const bats = [
  { top: '10%', scale: 0.75, loop: 22, delay: -3, swoop: 3.2, reverse: false },
  { top: '20%', scale: 0.5, loop: 30, delay: -16, swoop: 2.6, reverse: true },
  { top: '6%', scale: 0.625, loop: 38, delay: -27, swoop: 3.8, reverse: false },
];
---

<div class="sky-life" aria-hidden="true" transition:persist="sky-life">
  <div class="stars"></div>
  {
    clouds.map((c) => (
      <img
        class="cloud"
        src={c.src}
        alt=""
        width={c.w}
        height={c.h}
        style={`--w: ${c.w}; --h: ${c.h}; top: ${c.top}; --x: ${c.x}vw; animation-duration: ${c.duration}s; animation-delay: ${c.delay}s`}
      />
    ))
  }
  {
    birds.map((b) => (
      <div
        class="bird"
        style={`top: ${b.top}; --scale: ${b.scale}; animation-duration: 0.6s, ${b.loop}s, 2.4s; animation-delay: 0s, ${b.delay}s, 0s`}
      />
    ))
  }
  {
    bats.map((b) => (
      <div
        class="bat"
        style={`top: ${b.top}; --scale: ${b.scale}; animation-duration: 0.28s, ${b.loop}s, ${b.swoop}s; animation-delay: 0s, ${b.delay}s, 0s; animation-direction: normal, ${b.reverse ? 'reverse' : 'normal'}, normal`}
      />
    ))
  }
  <div class="precip"></div>
  <div class="flash"></div>
</div>
