---
// Easter egg: a rustling tuft in the grass opens controls for time of day and weather.
// Choices are stored as the session override that SkyState.astro reads.
const groups = [
  { key: 'time', legend: 'Time of day', values: ['auto', 'day', 'dawn', 'dusk', 'night'] },
  { key: 'weather', legend: 'Weather', values: ['auto', 'clear', 'cloudy', 'rain', 'snow', 'storm'] },
];
---

<button
  class="tuft"
  type="button"
  popovertarget="sky-controls"
  aria-label="Something is rustling in the grass"
  title="Something is rustling in the grass…"
  hidden
>
</button>

<div id="sky-controls" class="sky-controls" popover aria-labelledby="sky-controls-title">
  <h2 id="sky-controls-title">Change the sky</h2>
  {
    groups.map((g) => (
      <fieldset>
        <legend>{g.legend}</legend>
        {g.values.map((v) => (
          <label>
            <input type="radio" name={`sky-${g.key}`} value={v} data-key={g.key} />
            <span class="cursor" aria-hidden="true">▶</span>
            {v}
          </label>
        ))}
      </fieldset>
    ))
  }
  <button class="close" type="button" popovertarget="sky-controls" popovertargetaction="hide">
    Close
  </button>
</div>

<script>
  const KEY = 'sky-override';

  const read = (): Record<string, string> => {
    try {
      return JSON.parse(sessionStorage.getItem(KEY) ?? '{}') ?? {};
    } catch {
      return {};
    }
  };

  // The footer normally persists across navigation, but if a page swap ever replaces it,
  // set up the new copy too: this runs on the first load and after every navigation.
  const setup = () => {
    // Controls only work with JS, so the tuft only appears with it.
    document.querySelector<HTMLButtonElement>('.tuft')?.removeAttribute('hidden');

    const panel = document.getElementById('sky-controls');
    if (!panel || panel.dataset.ready) return;
    panel.dataset.ready = 'true';

    // Reflect the current override whenever the panel opens.
    panel.addEventListener('toggle', () => {
      const o = read();
      panel.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
        input.checked = (o[input.dataset.key ?? ''] ?? 'auto') === input.value;
      });
    });

    panel.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      const key = input.dataset.key;
      if (!key) return;
      const o = read();
      if (input.value === 'auto') delete o[key];
      else o[key] = input.value;
      try {
        sessionStorage.setItem(KEY, JSON.stringify(o));
      } catch {}
      document.dispatchEvent(new Event('sky:refresh'));
    });
  };

  document.addEventListener('astro:page-load', setup);
</script>

<style>
  /* tuft.svg: 4 frames of 18×14 (upright, left, upright, right). */
  .tuft {
    /* In the foreground: a bit larger than the lawn and set lower, in front of it.
       (--sea-h was resolved on .ground, so this local --px only scales the tuft.) */
    --px: 4.5px;
    position: absolute;
    left: 72%;
    top: calc(var(--sea-h) - 30px);
    width: calc(18 * var(--px));
    height: calc(14 * var(--px));
    padding: 0;
    border: 0;
    cursor: pointer;
    background: url('/sprites/tuft.svg') 0 0 / calc(72 * var(--px)) 100%;
    animation: rustle 9s step-end infinite;
    anchor-name: --tuft;
  }

  /* eyes.svg: 2 frames of 18×14 (open, blink), overlaid on the tuft. */
  .tuft::after {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/sprites/eyes.svg') 0 0 / calc(36 * var(--px)) 100%;
    opacity: 0;
    animation: peek 9s step-end infinite;
  }

  .tuft[hidden] {
    display: none;
  }

  .tuft:hover {
    animation-duration: 1.2s;
  }

  .tuft:hover::after,
  .tuft:focus-visible::after {
    animation: none;
    opacity: 1;
  }

  .tuft:focus-visible {
    outline: var(--px) dashed var(--dialog-ink);
    outline-offset: var(--px);
  }

  /* Each 9s cycle: still, a quick rustle, then eyes peek out, blink once, and hide. */
  @keyframes rustle {
    0%,
    76% {
      background-position-x: 0;
    }
    68%,
    74% {
      background-position-x: calc(-18 * var(--px));
    }
    70%,
    75% {
      background-position-x: calc(-54 * var(--px));
    }
    72% {
      background-position-x: calc(-36 * var(--px));
    }
  }

  @keyframes peek {
    0%,
    96% {
      opacity: 0;
      background-position-x: 0;
    }
    77% {
      opacity: 1;
    }
    86% {
      background-position-x: calc(-18 * var(--px));
    }
    87.5% {
      background-position-x: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tuft::after {
      animation: none;
      opacity: 1;
    }
  }

  .sky-controls {
    width: min(22rem, calc(100vw - 2rem));
    margin: 0;
    inset: auto auto 1rem 50%;
    translate: -50% 0;
    padding: 1.25rem 1.5rem;
    color: var(--dialog-ink);
    background: var(--dialog-bg);
    border: var(--px) solid var(--dialog-ink);
    border-radius: calc(var(--px) * 2);
    box-shadow:
      inset 0 0 0 var(--px) var(--dialog-bg),
      inset 0 0 0 calc(var(--px) * 2) var(--dialog-frame),
      0 calc(var(--px) * 2) 0 oklch(0% 0 0 / 0.25);
    font-family: var(--font-pixel);
  }

  /* Pop up right above the tuft where anchor positioning is supported. */
  @supports (anchor-name: --a) {
    .sky-controls {
      position-anchor: --tuft;
      position-area: top;
      position-try-fallbacks: flip-block;
      inset: auto;
      translate: none;
      margin-block: calc(var(--px) * 2);
    }
  }

  .sky-controls::backdrop {
    background: transparent;
  }

  h2 {
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
  }

  fieldset {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.25rem 0.5rem;
    margin: 0 0 1rem;
    padding: 0;
    border: 0;
  }

  legend {
    margin-bottom: 0.375rem;
    font-size: 0.875rem;
    opacity: 0.7;
  }

  label {
    position: relative;
    padding-left: 1.1em;
    cursor: pointer;
  }

  input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .cursor {
    position: absolute;
    left: 0;
    font-size: 0.7em;
    top: 50%;
    translate: 0 -50%;
    visibility: hidden;
  }

  label:has(:checked) .cursor {
    visibility: visible;
  }

  label:hover,
  label:has(:focus-visible) {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .close {
    padding: 0.25rem 0.75rem;
    font: inherit;
    color: var(--dialog-bg);
    background: var(--dialog-ink);
    border: 0;
    border-radius: var(--px);
    cursor: pointer;
  }
</style>
